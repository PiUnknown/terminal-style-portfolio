# PostHog Web Analytics (Get yours at https://us.posthog.com/project/settings)
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Blog Unique View Counter (Upstash Redis / Vercel KV - https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
VIEWS_SALT=custom_random_salt_for_ip_hashing
